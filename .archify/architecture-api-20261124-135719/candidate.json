      "type": "backend",
      "label": "Express app",
      "sublabel": "helmet, CORS, JSON + file bodies",
      "explanation": "createApp() sets security headers, CORS from CORS_ORIGINS, a request id, JSON bodies (1 MB) and raw file bodies (6 MB) for photos, documents and imports, then mounts every module's routes under /api/v1.",
      "sources": [
        { "path": "src/app.ts", "line": 82, "end_line": 98, "label": "middleware" },
