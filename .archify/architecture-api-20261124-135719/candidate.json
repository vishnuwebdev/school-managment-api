    {
      "id": "signin",
      "type": "security",
      "label": "Sign-in",
      "sublabel": "email or mobile + password",
      "tag": "rate limited",
      "explanation": "POST /auth/login checks the password (argon2), creates a session row and returns a signed JWT access token carrying user, session and membership ids. Public route, limited to 10 attempts a minute.",
      "sources": [
        { "path": "src/modules/identity/auth.routes.ts", "line": 38, "end_line": 60 },
        { "path": "src/modules/identity/auth.service.ts", "line": 310, "end_line": 322, "label": "session + token" }
      ]
    },
    {
      "id": "pipeline",
      "type": "security",
      "label": "Request pipeline",
      "sublabel": "who, which school, allowed?",
      "explanation": "Every non-public route runs: authenticate (token + live session + active user and membership), resolve the school from the membership (never the request body), check school status and subscription, then check the route's permission and the school's plan features.",
      "sources": [
        { "path": "src/http/route.ts", "line": 84, "end_line": 91, "label": "chain order" },
        { "path": "src/http/pipeline.ts", "line": 52, "end_line": 97, "label": "authenticate" },
        { "path": "src/http/pipeline.ts", "line": 199, "end_line": 257, "label": "school + permission" }
      ]
    },
    {
      "id": "modules",
      "type": "backend",
      "label": "Feature modules",
      "sublabel": "students, fees, exams, attendance…",
      "explanation": "About 24 folders under src/modules, each with routes (zod-validated), a service and schemas. Services run SQL in a transaction and call recordChange for every business change.",
      "sources": [
        { "path": "src/modules/students/students.service.ts", "line": 550, "end_line": 552, "label": "transaction" },
        { "path": "src/http/route.ts", "line": 92, "end_line": 101, "label": "validate + handler" }
      ]
    },
    {
      "id": "recorder",
      "type": "backend",
      "label": "Change recorder",
      "sublabel": "audit row + outbox event",
      "explanation": "recordChange writes the audit row and, when the change has an event, an outbox_events row, using the same transaction as the business change. All three commit or none do.",
      "sources": [
        { "path": "src/platform/record.ts", "line": 25, "end_line": 49 },
        { "path": "src/platform/outbox.ts", "line": 20, "end_line": 42 }
      ]
    },
    {
      "id": "inline",
      "type": "backend",
      "label": "In-API outbox relay",
      "sublabel": "only when REDIS_URL is not set",
      "explanation": "Without Redis there is no worker: the API process itself polls pending outbox rows and runs their handlers.",
      "sources": [
        { "path": "src/server.ts", "line": 6, "end_line": 8 },
        { "path": "src/events/inline-relay.ts", "line": 13, "end_line": 31 }
