PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# memory | mysql | mongo. "memory" needs nothing else below and auto-seeds
# on every boot -- good for trying the API with zero setup. Switch to mysql
# or mongo once you have a real instance, run the matching setup, then
# `npm run seed` once.
DATABASE_DRIVER=memory
DATABASE_URL=

# local is the only implemented driver (no third-party signup for dev).
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_PATH=storage/uploads

# Keep true only for local development. Set to false before any shared or
# production deployment -- dev-login skips password verification.
ALLOW_DEV_LOGIN=true
