# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins for the admin web app.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- Database (MySQL 8) ----
DATABASE_URL=mysql://sms:sms@localhost:3306/sms_dev

# ---- Redis (optional: cache + BullMQ worker) ----
# Leave empty to run without Redis: no cache, and the API sends emails itself
# (no need to run the worker).
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=school-management
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
REFRESH_IDLE_DAYS=7
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30

# ---- Links sent in emails ----
APP_BASE_URL=http://localhost:8080

# ---- Mail ----
# console = print emails to the worker log (development). smtp = real delivery (not yet implemented).
MAIL_DRIVER=console
MAIL_FROM=no-reply@example.com

# ---- File storage ----
# local = files on disk under STORAGE_DIR (back this folder up). s3 = reserved, not built yet.
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# ---- Encryption at rest (bank account numbers). Required in production; 32+ random characters.
# Changing it makes existing encrypted values unreadable, so store it with your other secrets.
DATA_ENCRYPTION_KEY=

# ---- Subscription policy ----
SUBSCRIPTION_GRACE_DAYS=30

# ---- Bootstrap platform super admin (used by `npm run db:seed` only) ----
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!12345
