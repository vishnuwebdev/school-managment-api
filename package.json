{
  "name": "edusphere-api",
  "version": "1.0.0-phase1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:demo": "tsx src/scripts/seed-demo.ts",
    "scopes:report": "tsx src/scripts/scope-report.ts",
    "openapi": "tsx src/scripts/export-openapi.ts docs/api/openapi.json",
    "db:studio": "drizzle-kit studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.9",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "mysql2": "^3.24.4",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "description": "EduSphere multi-tenant school management API",
  "engines": {
    "node": ">=22"
  }
}
